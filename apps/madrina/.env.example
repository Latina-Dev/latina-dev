# Slack app (from api.slack.com/apps > your app)
# SLACK_BOT_TOKEN=xoxb-... (optional: `slack run` injects SLACK_CLI_XOXB; only set this for Vercel)
SLACK_SIGNING_SECRET=your-signing-secret

# Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key
# Needed only if your key isn't scoped to a workspace (Console > Settings > Workspaces, wrkspc_...)
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Optional: override the model and effort (defaults: claude-opus-5-5, medium)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# Local dev tunnel for `slack run` (free at dashboard.ngrok.com)
NGROK_AUTH_TOKEN=your-ngrok-token

# Cron auth (step 5). Vercel sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=any-long-random-string

# MCP connector at /api/mcp. Clients send "Authorization: Bearer $MCP_TOKEN". Unset = the route rejects everything.
MCP_TOKEN=any-long-random-string

# Who the cron checks in with (your Slack member ID, U...). Without it, the cron uses whoever last opened App Home.
# MADRINA_DEMO_USER_ID=U...
